FROM python:3.11-slim

WORKDIR /app

# CPU-only PyTorch: spart ~4 GB CUDA-Ballast im Image (schnellerer Pull/Pod-Start)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir "transformers>=4.45.0,<5" sentencepiece protobuf

COPY README.md LICENSE pyproject.toml /app/
COPY rerankers /app/rerankers
RUN pip install --no-cache-dir .

COPY rest /app/rest

# Modell ins Image backen (kein Download beim Pod-Start)
RUN python -c "from rest.fast_colbert import FastColBERT; FastColBERT()"

ENV RANKER_MODEL=colbert \
    COLBERT_MODEL=colbert-ir/colbertv2.0 \
    COLBERT_DTYPE=fp32 \
    DOC_MAXLEN=180 \
    BATCH_SIZE=32 \
    EMB_CACHE_SIZE=0 \
    MALLOC_ARENA_MAX=2 \
    HF_HUB_OFFLINE=1

EXPOSE 8000

# Kein --reload in Produktion, 1 Worker: das Modell nutzt bereits alle vCPUs
CMD ["uvicorn", "rest.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
